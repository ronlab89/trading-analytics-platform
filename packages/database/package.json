{
  "name": "@trading/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:test:migrate": "dotenv -e ../../.env.test.local -- prisma migrate deploy",
    "db:runtime-password": "dotenv -e ../../.env -- tsx prisma/set-runtime-password.ts",
    "db:test:runtime-password": "dotenv -e ../../.env.test.local -- tsx prisma/set-runtime-password.ts",
    "db:reset": "dotenv -e ../../.env -- tsx prisma/reset.ts",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env.test.local -- vitest run",
    "test:watch": "dotenv -e ../../.env.test.local -- vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@trading/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
