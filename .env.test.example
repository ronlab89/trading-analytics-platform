# Environment used by integration/database tests (vitest, supertest).
# Points at a separate database on the same local Postgres instance so
# tests never touch development data (10-testing-strategy.md §17, §46).
#
# Copy to .env.test.local (git-ignored) and adjust credentials to match
# your local Postgres user/password. Create the database once with:
#   CREATE DATABASE trading_analytics_test OWNER trading_user;

DATABASE_URL="postgresql://trading_user:change_me_in_local_env@localhost:5432/trading_analytics_test?schema=public"

# apps/api — NODE_ENV=test disables rate limiting for the integration
# suite (see middleware/rate-limit.ts). JWT_SECRET only needs to be
# valid (32+ chars); it never has to match the development secret.
NODE_ENV=test
JWT_SECRET=test_only_secret_at_least_32_characters_long
JWT_EXPIRES_IN_SECONDS=900
CORS_ORIGIN=http://localhost:5173
